# Local PostgreSQL instance managed by Docker Compose.
POSTGRES_DB=registrybridge
POSTGRES_USER=registrybridge
POSTGRES_PASSWORD=replace-with-a-local-password

# Read-only deployment configuration shown in the Control Plane.
REGISTRYBRIDGE_TARGET_REGISTRY=example.azurecr.io
REGISTRYBRIDGE_CREDENTIAL_HANDLE_NAME=target-acr
REGISTRYBRIDGE_CREDENTIAL_HANDLE_TYPE=OciRegistry
